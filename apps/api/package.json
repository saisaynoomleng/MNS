{
  "name": "@mns/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf ./dist",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/helmet": "^4.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "1.0.0-rc.4",
    "tsx": "^4.23.13"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1138.0",
    "@epic-web/remember": "^1.1.0",
    "@mns/email": "workspace:*",
    "@mns/utils": "workspace:*",
    "better-auth": "^1.7.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  }
}
